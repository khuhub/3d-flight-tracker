# Copy to .env (git-ignored). Never commit real credentials.

# replay (default) or live, used by `npm start`. `npm run dev` is always replay; `npm run dev:live` is always live.
FLIGHT_MODE=replay
PORT=8787

# OpenSky API client (Account page -> API client). Leave empty for anonymous access.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Live polling interval in seconds. 180 s uses ~1,920 of a standard account's 4,000 daily credits.
# Anonymous accounts get 400 credits/day: use 900 (15 min) or more for continuous use.
POLL_INTERVAL_S=180

# Directory of recorded snapshots used by replay mode.
REPLAY_DIR=data/recordings
